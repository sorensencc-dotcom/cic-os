  },
  "dependencies": {
    "@visx/axis": "^3.10.0",
    "@visx/group": "^3.10.0",
    "@visx/legend": "^3.10.0",
    "@visx/scale": "^3.10.0",
    "@visx/tooltip": "^3.10.0",
    "@visx/xychart": "^3.10.0",
    "d3-scale": "^4.0.2",
    "dockerode": "^4.0.0",
    "express": "^4.18.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.0",
    "pg": "^8.11.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "prom-client": "^15.1.3",
