# Dockerfile.ingestion - CIC Autonomy API Server + Memory/Retention
# Builds cic-ingestion service from source

FROM node:20-alpine AS builder

WORKDIR /workspace

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

# Copy cic-ingestion service
COPY cic-ingestion/package.json cic-ingestion/package-lock.json ./
RUN npm ci

COPY cic-ingestion/src ./src
COPY cic-ingestion/tests ./tests
COPY cic-ingestion/tsconfig.json .

# Build TypeScript
RUN npm run build || true

# Runtime Stage
FROM node:20-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache curl bash postgresql-client

# Copy production dependencies and built code
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/dist ./dist
COPY --from=builder /workspace/package.json ./package.json
COPY cic-ingestion/.env.example .env

ENV NODE_ENV=production
ENV PORT=3000
ENV LOG_LEVEL=info

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "dist/AutonomyAPIServer.js"]
