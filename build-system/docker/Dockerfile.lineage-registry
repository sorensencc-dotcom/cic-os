FROM node:20-alpine AS base
WORKDIR /app

RUN apk add --no-cache git curl jq postgresql-client

COPY cic/package.json cic/package-lock.json ./
RUN npm ci --omit=dev

COPY cic/dist ./dist
COPY cic/src/db/migrations.ts ./migrations/

ENV NODE_ENV=production
ENV LOG_LEVEL=info
ENV DB_HOST=postgres
ENV DB_PORT=5432
ENV DB_NAME=cic_lineage

EXPOSE 3102

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3102/health || exit 1

ENTRYPOINT ["node", "dist/build-system/lineage-registry.js"]
CMD ["serve", "--port", "3102"]
