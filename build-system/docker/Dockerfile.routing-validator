FROM node:20-alpine AS base
WORKDIR /app

RUN apk add --no-cache git curl jq

COPY cic/package.json cic/package-lock.json ./
RUN npm ci --omit=dev

COPY cic/dist ./dist
COPY phase0.7/policies/cic.routing.rego ./policies/
COPY phase0.7/build-system/routing/phase0.7-routing.yaml ./config/

ENV NODE_ENV=production
ENV LOG_LEVEL=info
ENV OPA_ENABLED=true

EXPOSE 3103

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3103/health || exit 1

ENTRYPOINT ["node", "dist/build-system/routing-engine.js"]
CMD ["serve", "--port", "3103"]
