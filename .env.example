# CIC Docker Environment Configuration
# Copy to .env and fill in your values before running docker-compose
# IMPORTANT: Never commit .env — only .env.example is tracked

# ─── REQUIRED ───────────────────────────────────────────────────────────────
# Your Anthropic API key (get from https://console.anthropic.com)
# Format: sk-ant-...
CLAUDE_API_KEY=sk-ant-YOUR_API_KEY_HERE

# ─── OPTIONAL ───────────────────────────────────────────────────────────────
# Environment tag (development, staging, production)
CIC_ENV=development

# MCP server primary port (must be free on host)
CIC_MCP_PORT=3100

# Log directory (relative to project root)
CIC_LOG_DIR=./logs

# Startup timeout in seconds (wait for MCP port)
CIC_STARTUP_TIMEOUT=60

# Dry-run mode: validate without launching services
# Set to "true" to test startup sequence safely
CIC_DRY_RUN=false

# Claude Code: disable interactive permission prompts in Docker
# Safe in Docker since filesystem access is already scoped
CLAUDE_SKIP_PERMISSIONS=true

# ─── OPTIONAL: SSH ACCESS ───────────────────────────────────────────────────
# To enable SSH from mobile devices, add your public key:
# Copy your ~/.ssh/id_rsa.pub contents and uncomment:
# SSH_PUBLIC_KEY="ssh-rsa AAAA... your@host"
